ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
PORT=3001

# Optional. Defaults to walking up from the erp package until data/scenarios is found.
# SCENARIOS_DIR=

# Start a scenario run: POST /api/runs { "scenarioId": "s1-recommendation-review" }
# Optional extra buyer text: { "scenarioId": "...", "prompt": "Prefer SUP-VEND-02" }
# Smoke: cd ../agent && yarn smoke:scenario
